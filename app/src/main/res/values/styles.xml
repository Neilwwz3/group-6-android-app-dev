<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Group6.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Group6.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Group6.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_card_title</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Group6.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Group6.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Widget.Group6.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/corner_card</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/card_outline_width</item>
    </style>
    <style name="Widget.Group6.StatusBadge" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Group6.Caption</item>
        <item name="android:paddingStart">@dimen/badge_horizontal_padding</item>
        <item name="android:paddingEnd">@dimen/badge_horizontal_padding</item>
        <item name="android:paddingTop">@dimen/badge_vertical_padding</item>
        <item name="android:paddingBottom">@dimen/badge_vertical_padding</item>
    </style>
    <style name="Widget.Group6.StatusBadge.Want" parent="Widget.Group6.StatusBadge">
        <item name="android:background">@drawable/status_want</item>
        <item name="android:textColor">@color/status_want_text</item>
    </style>
    <style name="Widget.Group6.StatusBadge.Watching" parent="Widget.Group6.StatusBadge">
        <item name="android:background">@drawable/status_watching</item>
        <item name="android:textColor">@color/status_watching_text</item>
    </style>
    <style name="Widget.Group6.StatusBadge.Watched" parent="Widget.Group6.StatusBadge">
        <item name="android:background">@drawable/status_watched</item>
        <item name="android:textColor">@color/status_watched_text</item>
    </style>
    <style name="Widget.Group6.StatusBadge.Dropped" parent="Widget.Group6.StatusBadge">
        <item name="android:background">@drawable/status_dropped</item>
        <item name="android:textColor">@color/status_dropped_text</item>
    </style>
    <style name="Widget.Group6.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@drawable/filter_background</item>
        <item name="android:textColor">@drawable/filter_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Group6.Body</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="android:checkable">true</item>
    </style>
    <style name="Widget.Group6.RatingBar.Small" parent="Widget.AppCompat.RatingBar.Small">
        <item name="android:isIndicator">true</item>
        <item name="android:numStars">5</item>
        <item name="android:stepSize">0.5</item>
        <item name="android:progressTint">@color/rating</item>
        <item name="android:progressBackgroundTint">@color/outline</item>
        <item name="android:secondaryProgressTint">@color/outline</item>
    </style>
    <style name="Widget.Group6.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="itemIconTint">@drawable/nav_tint</item>
        <item name="itemTextColor">@drawable/nav_tint</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="Widget.Group6.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/on_primary</item>
    </style>
    <style name="ShapeAppearance.Group6.Button" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/corner_button</item>
    </style>
</resources>
