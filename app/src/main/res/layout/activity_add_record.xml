<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/record_root"
    android:theme="@style/Theme.Group6androidappdev"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.record.AddRecordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/record_toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:layout_gravity="start"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:drawablePadding="@dimen/space_8"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/space_12"
            android:text="@string/record_back"
            android:textAllCaps="true"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_card_title"
            app:drawableStartCompat="@drawable/ic_nav_back"
            app:drawableTint="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/record_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:labelFor="@id/record_date"
            android:text="@string/record_watch_date"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_card_title" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/record_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:background="?attr/selectableItemBackground"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:freezesText="true"
            android:gravity="start|center_vertical"
            android:paddingStart="0dp"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_title"
            tools:text="2026-11-11" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            app:boxBackgroundColor="@android:color/transparent"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/record_minutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:hint="@string/record_duration_minutes"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_card_title" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:labelFor="@id/record_rating"
            android:text="@string/record_rating_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_card_title" />

        <androidx.appcompat.widget.AppCompatRatingBar
            android:id="@+id/record_rating"
            style="@style/Widget.AppCompat.RatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:isIndicator="false"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/outline"
            android:secondaryProgressTint="@color/outline"
            android:stepSize="0.5"
            tools:rating="4.5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:labelFor="@id/record_note"
            android:text="@string/record_short_review"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_card_title" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:boxBackgroundColor="@android:color/transparent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/record_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:lines="3"
                android:scrollbars="vertical"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_card_title" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/record_save"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:minHeight="@dimen/touch_target"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/record_save_label"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/text_card_title"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/space_24" />

    </LinearLayout>
</ScrollView>
