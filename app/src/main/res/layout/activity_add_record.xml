<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/record_root"
    android:theme="@style/Theme.Group6androidappdev"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.record.AddRecordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/record_toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:layout_gravity="start"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:drawablePadding="@dimen/space_8"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/space_12"
            android:text="@string/record_back"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Group6.CardTitle"
            app:drawableStartCompat="@drawable/ic_nav_back"
            app:drawableTint="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/record_title"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.Group6.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:labelFor="@id/record_date"
            android:text="@string/record_watch_date"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Group6.CardTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/record_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/record_date_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions"
                    android:minHeight="@dimen/touch_target"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Group6.Body"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/record_select_date"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:minHeight="@dimen/touch_target"
                android:text="@string/record_open_calendar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/record_episodes_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/record_watched_episodes">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/record_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Group6.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/record_select_episodes"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:minHeight="@dimen/touch_target"
                android:text="@string/record_select_episodes" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:hint="@string/record_duration_minutes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/record_minutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textAppearance="@style/TextAppearance.Group6.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:labelFor="@id/record_rating"
            android:text="@string/record_rating_label"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Group6.CardTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatRatingBar
                android:id="@+id/record_rating"
                style="@style/Widget.AppCompat.RatingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="false"
                android:numStars="5"
                android:progressTint="?attr/colorSecondary"
                android:progressBackgroundTint="@color/outline"
                android:rating="5"
                android:secondaryProgressTint="@color/outline"
                android:stepSize="0.5" />

            <TextView
                android:id="@+id/record_rating_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.Group6.Body"
                android:textColor="@color/text_secondary"
                tools:text="10/10" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/record_clear_rating"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/record_clear_rating" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/record_note"
                android:text="@string/record_short_review"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Group6.CardTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/record_clear_review"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/record_clear_review"
                android:textColor="@color/error" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/record_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:lines="3"
                    android:paddingBottom="@dimen/touch_target"
                    android:scrollbars="vertical"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Group6.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/record_review_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_8"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Group6.Caption"
                tools:text="0 characters" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/record_save"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:minHeight="@dimen/touch_target"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/record_save_label"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.Group6.CardTitle"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/space_24" />

    </LinearLayout>
</ScrollView>
