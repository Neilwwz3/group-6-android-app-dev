<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target"
        app:navigationIcon="@drawable/ic_nav_back"
        app:navigationContentDescription="@string/back"
        app:titleTextAppearance="@style/TextAppearance.Group6.CardTitle" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/detail_poster_letter"
                    android:layout_width="@dimen/poster_width"
                    android:layout_height="@dimen/poster_height"
                    android:background="@drawable/poster_placeholder"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Group6.Title"
                    android:textColor="@color/text_secondary"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_12"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Group6.Title"
                        android:accessibilityHeading="true" />
                    <TextView
                        android:id="@+id/detail_original"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.Group6.Caption"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/detail_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.Group6.Caption" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/detail_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                style="@style/Widget.Group6.StatusBadge" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/field_status"
                android:textAppearance="@style/TextAppearance.Group6.Caption" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/detail_status_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/detail_status_want"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_want"
                    android:tag="want"
                    style="@style/Widget.Group6.FilterChip" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/detail_status_watching"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_watching"
                    android:tag="watching"
                    style="@style/Widget.Group6.FilterChip" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/detail_status_watched"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_watched"
                    android:tag="watched"
                    style="@style/Widget.Group6.FilterChip" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/detail_status_dropped"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_dropped"
                    android:tag="dropped"
                    style="@style/Widget.Group6.FilterChip" />
            </com.google.android.material.chip.ChipGroup>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/detail_rating_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:hint="@string/field_rating"
                app:helperText="@string/rating_hint">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/detail_rating_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLength="4"
                    android:maxLines="1"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_clear_rating"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/clear_rating" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detail_edit"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/edit" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detail_delete"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/delete"
                    android:textColor="@color/error" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/records_title"
                    android:textAppearance="@style/TextAppearance.Group6.CardTitle" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detail_add_record"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/add_record" />
            </LinearLayout>
            <TextView
                android:id="@+id/records_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/records_empty"
                android:textAppearance="@style/TextAppearance.Group6.Body"
                android:textColor="@color/text_secondary" />
            <LinearLayout
                android:id="@+id/records_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
